# Server Application Configuration
PROJECT_NAME="Stateless Multi-Tenant AI Chat Support Engine"
VERSION="1.0.0"
DEBUG=true
LOG_LEVEL="INFO"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Qdrant Cloud Vector Database Configuration
QDRANT_URL="https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY="your-qdrant-cloud-api-key"
QDRANT_COLLECTION_NAME="multitenant_chat_support"

# Jina Embeddings Configuration
JINA_EMBEDDINGS_URL="https://api.jina.ai/v1/embeddings"
JINA_MODEL_NAME="jina-embeddings-v3"

# LLM Provider Model Listing Base API URLs
OPENAI_MODELS_API_BASE="https://api.openai.com/v1"
GROQ_MODELS_API_BASE="https://api.groq.com/openai/v1"
GEMINI_MODELS_API_BASE="https://generativelanguage.googleapis.com/v1beta"

# LangSmith Observability & Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="stateless-chat-support"

# NOTE: Stateless Tenant Security Policy
# Tenant API keys (X-Jina-Api-Key, X-LLM-Api-Key) and provider choices (X-LLM-Provider)
# are passed dynamically per-request via HTTP headers. They are NEVER stored here or persisted.
